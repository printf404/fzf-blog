---
import { getCollection } from "astro:content";
import WidgetLayout from "@/components/common/WidgetLayout.astro";

// 从 content/ziyuan/everyday.md 读取名言数据
const entries = await getCollection("EveryDaysay");
const everydayEntry = entries.find((e) => e.id === "everyday.md");
const everydayData = everydayEntry?.data as any;
const everydays = everydayData?.everydays || [];

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

// 使用日期作为随机种子，确保同一天显示相同的名言
const today = new Date();
const dateStr = today.toISOString().split("T")[0];
const seed = dateStr
	.split("")
	.reduce((acc, char) => acc + char.charCodeAt(0), 0);
const randomIndex = seed % everydays.length;
const everyday = everydays[randomIndex] || { text: "暂无名言", author: "" };
---

<WidgetLayout name="✨ 今日一言" id="everyday-of-the-day" class={className} style={style}>
	<div class="everyday-content">
		<blockeveryday class="everyday-text">
			<span class="everyday-mark">"</span>
			{everyday.text}
			<span class="everyday-mark">"</span>
		</blockeveryday>
		<cite class="everyday-author">—— {everyday.author}</cite>
	</div>
</WidgetLayout>

<style>
	.everyday-content {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 0.5rem 0;
	}

	.everyday-text {
		position: relative;
		font-style: italic;
		font-size: 0.9rem;
		line-height: 1.6;
		padding: 0 0.5rem;
		margin: 0;
	}

	.everyday-mark {
		font-size: 1.5rem;
		line-height: 0;
		vertical-align: middle;
		color: var(--primary);
		opacity: 0.6;
		font-family: Georgia, serif;
	}

	.everyday-author {
		display: block;
		text-align: right;
		font-size: 0.75rem;
		color: var(--content-meta);
		font-style: normal;
		margin-top: 0.25rem;
	}

	/* 深色模式优化 */
	:global(html.dark) .everyday-text {
		color: #fff;
	}

	/* 悬停效果 */
	:global(.everyday-content:hover .everyday-text) {
		color: var(--primary);
		transition: color 0.2s ease;
	}
</style>
