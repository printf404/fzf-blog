---
import { Icon } from "astro-icon/components";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const customProps = (widgetConfig?.customProps ?? {}) as Record<string, unknown>;
const imageUrl = typeof customProps.imageUrl === "string" ? customProps.imageUrl : "";
const greetingImages =
	typeof customProps.greetingImages === "object" &&
	customProps.greetingImages !== null
		? (customProps.greetingImages as Record<string, string>)
		: {};
const initialImageUrl = imageUrl || greetingImages["中午"] || "";
const imageAlt =
	typeof customProps.imageAlt === "string" ? customProps.imageAlt : "问候配图";
---

<section
	class:list={["card-base", "time-greeting-widget", "p-4", className]}
	style={style}
	data-time-greeting-images={JSON.stringify(greetingImages)}
>
	<div class="flex items-start justify-between gap-3">
		<div class="min-w-0">
			<div
				class="time-greeting-text mb-2 text-base font-bold text-neutral-800 transition dark:text-neutral-100"
				data-time-greeting-text
			>
				中午好，记得午休！
			</div>
			<div class="flex items-end gap-3">
				<div
					class="font-mono text-4xl font-black leading-none tracking-tight text-neutral-900 transition dark:text-neutral-50"
					data-time-greeting-clock
				>
					12:56
				</div>
				<div class="pb-0.5 text-xs font-bold uppercase leading-tight tracking-wider text-neutral-400">
					<div data-time-greeting-weekday>SUNDAY</div>
					<div data-time-greeting-date>09/08</div>
				</div>
			</div>
		</div>
		<Icon
			is:inline
			name="material-symbols:light-mode-outline-rounded"
			class="time-greeting-sun mt-1 shrink-0 text-3xl text-(--primary)"
			aria-hidden="true"
		/>
	</div>

	<div class="mt-4 overflow-hidden rounded-2xl">
		{
			initialImageUrl ? (
				<img
					src={initialImageUrl}
					alt={imageAlt}
					class="h-34 w-full object-cover"
					loading="lazy"
					data-time-greeting-image
				/>
			) : (
				<div class="time-greeting-image-placeholder flex h-34 flex-col items-center justify-center gap-2 px-4 text-center">
					<Icon
						is:inline
						name="material-symbols:add-photo-alternate-outline-rounded"
						class="text-3xl text-(--primary)"
						aria-hidden="true"
					/>
					<div class="text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
						图片链接预留位：到 `src/config/sidebarConfig.ts` 的 `timeGreeting.imageUrl` 填入你的图片链接。
					</div>
				</div>
			)
		}
	</div>
</section>

<style>
	.time-greeting-widget {
		overflow: hidden;
	}

	.time-greeting-sun {
		filter: drop-shadow(0 8px 18px color-mix(in oklab, var(--primary) 35%, transparent));
	}

	.time-greeting-image-placeholder {
		border: 1px dashed color-mix(in oklab, var(--primary) 45%, transparent);
		background:
			linear-gradient(
				135deg,
				color-mix(in oklab, var(--primary) 10%, transparent),
				color-mix(in oklab, var(--card-bg) 94%, transparent)
			);
	}
</style>

<script is:inline data-swup-ignore-script>
	(() => {
		const greetings = [
			{ key: "深夜", startHour: 23, endHour: 24, text: "深夜了，早点休息。" },
			{ key: "深夜", startHour: 0, endHour: 5, text: "深夜了，早点休息。" },
			{ key: "黎明", startHour: 5, endHour: 7, text: "黎明好，新的一天正在醒来。" },
			{ key: "早晨", startHour: 7, endHour: 9, text: "早上好，今天也要元气满满。" },
			{ key: "上午", startHour: 9, endHour: 12, text: "上午好，保持好心情。" },
			{ key: "中午", startHour: 12, endHour: 14, text: "中午好，记得午休！" },
			{ key: "下午", startHour: 14, endHour: 18, text: "下午好，喝口水再继续。" },
			{ key: "晚上", startHour: 18, endHour: 23, text: "晚上好，慢慢收个尾。" },
		];

		function updateTimeGreeting() {
			const root = document.querySelector(".time-greeting-widget");
			if (!root) return;

			const now = new Date();
			const hour = now.getHours();
			const minute = now.getMinutes();
			const greeting =
				greetings.find(
					(item) => hour >= item.startHour && hour < item.endHour,
				) || greetings[greetings.length - 1];
			let images = {};
			try {
				images = JSON.parse(root.getAttribute("data-time-greeting-images") || "{}");
			} catch {
				images = {};
			}
			const weekdays = [
				"SUNDAY",
				"MONDAY",
				"TUESDAY",
				"WEDNESDAY",
				"THURSDAY",
				"FRIDAY",
				"SATURDAY",
			];

			const text = root.querySelector("[data-time-greeting-text]");
			const clock = root.querySelector("[data-time-greeting-clock]");
			const weekday = root.querySelector("[data-time-greeting-weekday]");
			const date = root.querySelector("[data-time-greeting-date]");
			const image = root.querySelector("[data-time-greeting-image]");

			if (text) text.textContent = greeting.text;
			if (clock)
				clock.textContent = `${String(hour).padStart(2, "0")}:${String(
					minute,
				).padStart(2, "0")}`;
			if (weekday) weekday.textContent = weekdays[now.getDay()];
			if (date)
				date.textContent = `${String(now.getMonth() + 1).padStart(
					2,
					"0",
				)}/${String(now.getDate()).padStart(2, "0")}`;
			if (image && images[greeting.key] && image.getAttribute("src") !== images[greeting.key]) {
				image.setAttribute("src", images[greeting.key]);
				image.setAttribute("alt", `${greeting.key}问候配图`);
			}
		}

		updateTimeGreeting();
		window.setInterval(updateTimeGreeting, 30 * 1000);
		document.addEventListener("swup:contentReplaced", updateTimeGreeting);
	})();
</script>
